            {
              "name": "Appian Get deployment results",
              "id": "83b77703-4c2d-4941-b895-6a5f40a77a40",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/deployments/:deploymentUuid",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "deployments",
                    ":deploymentUuid"
                  ],
                  "variable": [
                    {
                      "id": "2461bb5f-1104-4e26-8f7b-c5de3251b78a",
                      "key": "deploymentUuid",
                      "value": "<uuid>",
                      "description": "(Required) The UUID of the deployment operation to query. This is returned when creating a deployment via the POST /deployments endpoint."
                    }
                  ]
                },
                "description": "Retrieves the current status and results of a deployment operation identified by its UUID. The response structure varies depending on whether the deployment was an import or export operation. For imports, the response includes a summary of imported, failed, and skipped objects. For exports, the response includes URLs to download the exported package, plug-ins, customization files, and database scripts."
              },
              "response": [
                {
                  "id": "111b85aa-5a47-4bc1-aae3-ba695644423e",
                  "name": "Successfully retrieved deployment results. The response schema depends on whether the deployment was an import or export.",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: apikey",
                        "key": "appian-api-key",
                        "value": "<API Key>"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/deployments/:deploymentUuid",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "deployments",
                        ":deploymentUuid"
                      ],
                      "variable": [
                        {
                          "key": "deploymentUuid"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"status\": \"IN_PROGRESS\",\n  \"summary\": {\n    \"objects\": {\n      \"total\": \"<integer>\",\n      \"imported\": \"<integer>\",\n      \"failed\": \"<integer>\",\n      \"skipped\": \"<integer>\"\n    },\n    \"adminConsoleSettings\": {\n      \"total\": \"<integer>\",\n      \"imported\": \"<integer>\",\n      \"failed\": \"<integer>\",\n      \"skipped\": \"<integer>\"\n    },\n    \"plugins\": {\n      \"total\": \"<integer>\",\n      \"imported\": \"<integer>\",\n      \"skipped\": \"<integer>\"\n    },\n    \"databaseScripts\": \"<integer>\",\n    \"deploymentLogUrl\": \"<uri>\"\n  }\n}",
                  "createdAt": "2026-07-28T01:03:31.000Z",
                  "updatedAt": "2026-07-28T01:03:31.000Z",
