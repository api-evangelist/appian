          "item": [
            {
              "name": "Appian Get inspection results",
              "id": "2f27186e-b279-4ec2-a807-e9ddcba1de5f",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/inspections/:inspectionUuid",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "inspections",
                    ":inspectionUuid"
                  ],
                  "variable": [
                    {
                      "id": "f9a82bc7-423f-4343-963b-79697b41c42b",
                      "key": "inspectionUuid",
                      "value": "<uuid>",
                      "description": "(Required) The UUID of the inspection operation to query. This is returned when creating an inspection via the POST /inspections endpoint."
                    }
                  ]
                },
                "description": "Retrieves the current status and results of a package inspection operation identified by its UUID. The response includes a summary of expected objects, Admin Console settings, and any problems (errors and warnings) identified during the inspection."
              },
              "response": [
                {
                  "id": "1802b70a-1d21-4b51-8fff-a71920e4c2ec",
                  "name": "Successfully retrieved inspection results including any errors and warnings found.",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: apikey",
                        "key": "appian-api-key",
                        "value": "<API Key>"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/inspections/:inspectionUuid",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "inspections",
                        ":inspectionUuid"
                      ],
                      "variable": [
                        {
                          "key": "inspectionUuid"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"status\": \"IN_PROGRESS\",\n  \"summary\": {\n    \"objectsExpected\": {\n      \"total\": \"<integer>\",\n      \"imported\": \"<integer>\",\n      \"failed\": \"<integer>\",\n      \"skipped\": \"<integer>\"\n    },\n    \"adminConsoleSettingsExpected\": {\n      \"total\": \"<integer>\",\n      \"imported\": \"<integer>\",\n      \"failed\": \"<integer>\",\n      \"skipped\": \"<integer>\"\n    },\n    \"problems\": {\n      \"totalErrors\": \"<integer>\",\n      \"totalWarnings\": \"<integer>\",\n      \"errors\": [\n        {\n          \"errorMessage\": \"<string>\",\n          \"objectName\": \"<string>\",\n          \"objectUuid\": \"<uuid>\"\n        },\n        {\n          \"errorMessage\": \"<string>\",\n          \"objectName\": \"<string>\",\n          \"objectUuid\": \"<uuid>\"\n        }\n      ],\n      \"warnings\": [\n        {\n          \"warningMessage\": \"<string>\",\n          \"objectName\": \"<string>\",\n          \"objectUuid\": \"<uuid>\"\n        },\n        {\n          \"warningMessage\": \"<string>\",\n          \"objectName\": \"<string>\",\n          \"objectUuid\": \"<uuid>\"\n        }\n      ]\n    }\n  }\n}",
