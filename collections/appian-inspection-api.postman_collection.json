      "name": "Inspection",
      "description": {
        "content": "Operations for inspecting packages before deployment to identify potential issues, errors, and warnings.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e27c275b-dae6-49ab-837c-a5a8259e6c18",
          "name": "Appian Inspect a package before deployment",
          "request": {
            "name": "Appian Inspect a package before deployment",
            "description": {
              "content": "Creates a new inspection operation to analyze a deployment package before importing it into the target environment. The inspection identifies potential issues, errors, and warnings that may arise during deployment. The request requires the package file, Admin Console settings file, and optionally an import customization file as multipart form data. The response includes an inspection UUID that can be used to retrieve the inspection results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "inspections"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The Appian site domain, typically in the format mysite.appiancloud.com for cloud deployments.",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "json",
                  "value": "<string>",
                  "type": "text",
                  "description": "JSON string containing the inspection configuration with file name references for the attached files."
                },
                {
                  "key": "adminConsoleSettingsFileName",
                  "type": "file",
                  "description": "Admin Console settings ZIP file to use for the inspection."
                },
                {
                  "key": "packageFileName",
                  "type": "file",
                  "description": "The deployment package ZIP file to inspect."
                },
                {
                  "key": "customizationFileName",
                  "type": "file",
                  "description": "Optional import customization properties file to include in the inspection."
                }
              ]
            }
          },
