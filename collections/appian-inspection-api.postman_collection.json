        {
          "id": "e5bfbec9-88fa-4751-afef-ab1be06a88ab",
          "name": "Appian Get inspection results",
          "request": {
            "name": "Appian Get inspection results",
            "description": {
              "content": "Retrieves the current status and results of a package inspection operation identified by its UUID. The response includes a summary of expected objects, Admin Console settings, and any problems (errors and warnings) identified during the inspection.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "inspections",
                ":inspectionUuid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "inspectionUuid",
                  "description": "(Required) The UUID of the inspection operation to query. This is returned when creating an inspection via the POST /inspections endpoint."
                },
                {
                  "description": "The Appian site domain, typically in the format mysite.appiancloud.com for cloud deployments.",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
