    {
      "id": "ba14eed9-7a7f-4e8e-91ee-db094112a244",
      "name": "Import",
      "description": {
        "content": "Operations for importing and deploying applications and packages into an Appian environment.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "97da7de3-8eed-4512-9b99-27ae22f3d602",
          "name": "Appian Export or import a deployment",
          "request": {
            "name": "Appian Export or import a deployment",
            "description": {
              "content": "Creates a new deployment operation for either exporting or importing applications and packages. The Action-Type header determines whether the operation is an export or import. For exports, provide a JSON payload specifying the UUIDs and export type. For imports, provide a multipart form with the package files and deployment configuration. The response includes a deployment UUID that can be used to track progress and retrieve results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "deployments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The Appian site domain, typically in the format mysite.appiancloud.com for cloud deployments.",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Specifies whether the deployment operation is an export or import. If omitted, defaults to import.",
                "key": "Action-Type",
                "value": "import"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "json",
                  "value": "<string>",
                  "type": "text",
                  "description": "JSON string containing the deployment configuration. For exports, includes exportType and uuids. For imports, includes name, description, and file name references."
                },
                {
                  "key": "packageFileName",
                  "type": "file",
                  "description": "The deployment package ZIP file to import. Required for import operations."
                },
                {
                  "key": "adminConsoleSettingsFileName",
                  "type": "file",
                  "description": "Admin Console settings ZIP file to import alongside the package."
                },
                {
                  "key": "customizationFileName",
                  "type": "file",
                  "description": "Import customization properties file that maps source environment values to target environment values."
                },
                {
                  "key": "pluginsFileName",
                  "type": "file",
                  "description": "Plug-ins ZIP file containing plug-ins to deploy."
                }
              ]
            }
          },
