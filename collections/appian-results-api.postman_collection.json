      "item": [
        {
          "id": "08b833a7-6992-4aac-ac82-0299ace8a7fb",
          "name": "Appian Get deployment results",
          "request": {
            "name": "Appian Get deployment results",
            "description": {
              "content": "Retrieves the current status and results of a deployment operation identified by its UUID. The response structure varies depending on whether the deployment was an import or export operation. For imports, the response includes a summary of imported, failed, and skipped objects. For exports, the response includes URLs to download the exported package, plug-ins, customization files, and database scripts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "deployments",
                ":deploymentUuid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "deploymentUuid",
                  "description": "(Required) The UUID of the deployment operation to query. This is returned when creating a deployment via the POST /deployments endpoint."
                },
                {
                  "description": "The Appian site domain, typically in the format mysite.appiancloud.com for cloud deployments.",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
